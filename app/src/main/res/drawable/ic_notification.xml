<?xml version="1.0" encoding="utf-8"?>
<!--
    알림 표시줄·알림·빠른 설정 타일용 단색 아이콘(#404). 시스템이 알파만 보고 자체 색으로 칠하므로 흰색으로 둔다.
    앱 아이콘(원 하나 + 같은 원을 좌우로 민 호 둘, 끝으로 갈수록 옅어짐)의 모양을 따른다.
    24dp 에서도 알아보게 원의 선은 앱 아이콘보다 굵게 하고, 호의 옅어짐은 세로 그라데이션으로 살린다.
    호는 반지름이 같은 원을 좌우로 2.4 민 것의 ±52° 부분이다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 가운데 원 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M5.6,12a6.4,6.4 0 1,0 12.8,0a6.4,6.4 0 1,0 -12.8,0z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8" />

    <!-- 오른쪽 호 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M18.34,6.957A6.4,6.4 0 0,1 18.34,17.043"
        android:strokeLineCap="round"
        android:strokeWidth="1.6">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:centerColor="#D9FFFFFF"
                android:endColor="#00FFFFFF"
                android:endX="0"
                android:endY="17.043"
                android:startColor="#00FFFFFF"
                android:startX="0"
                android:startY="6.957"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- 왼쪽 호 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M5.66,17.043A6.4,6.4 0 0,1 5.66,6.957"
        android:strokeLineCap="round"
        android:strokeWidth="1.6">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:centerColor="#D9FFFFFF"
                android:endColor="#00FFFFFF"
                android:endX="0"
                android:endY="17.043"
                android:startColor="#00FFFFFF"
                android:startX="0"
                android:startY="6.957"
                android:type="linear" />
        </aapt:attr>
    </path>
</vector>
