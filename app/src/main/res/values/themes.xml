<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        앱 화면(MainActivity) 창의 테마. 화면은 Compose 가 그리지만, 앱을 켜서 첫 화면을 그리기 전의 시작 창과
        언어 변경·회전으로 다시 만들어지는 동안의 빈 창은 이 테마로 칠해진다.
        밝은 테마면 이때 흰 화면이 번쩍이므로, 어두운 테마에 앱 배경색(app_background)을 깐다.
        Android 12 이상의 스플래시 배경은 values-v31/themes.xml 에서 더한다.
    -->
    <style name="Base.Theme.SoundVisualizer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <!--
            첫 화면이 뜨면 MainActivity 가 바를 투명하게 바꿔 앱 배경이 비치게 한다(enableEdgeToEdge).
            그 전의 시작 창도 바가 같은 색이어야 켜는 순간 바의 색이 바뀌지 않는다. (Android 14 이하에서만 쓰인다.
            Android 15 이상은 이 앱의 창을 처음부터 투명한 바로 그리고, 그 밑에 창 배경이 보인다.)
        -->
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
    </style>

    <style name="Theme.SoundVisualizer" parent="Base.Theme.SoundVisualizer" />

    <!--
        실행 중 알림에서 모드를 고르는 칩 하나(notification_modes.xml).
        네 개가 가로 폭을 똑같이 나눠 가지므로 너비는 0dp + weight 1 이다.
        누르는 자리는 48dp 아래로 내려가지 않게 한다. 게임 위에서 급하게 누르는 버튼이다.
        글자와 배경색을 왜 고정하는지는 colors.xml 의 notification_chip_* 주석에 적어 두었다.
    -->
    <style name="NotificationModeChipBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
    </style>

    <!-- Android 11 이하에서 쓰는 칩. 고른 칩 표시는 AudioCaptureService 가 배경과 글자색을 직접 바꿔서 한다. -->
    <style name="NotificationModeChip" parent="NotificationModeChipBase">
        <item name="android:background">@drawable/notification_mode_chip_off</item>
        <item name="android:textColor">@color/notification_chip_text_off</item>
    </style>

    <!--
        Android 12 이상에서 쓰는 칩. 고른 칩 표시가 `state_checked` 로 정해지므로, 누른 즉시 알림을 그리는
        쪽에서 바뀐다. 라디오 동그라미는 지우고 칩 모양만 남긴다.
    -->
    <style name="NotificationModeChipButton" parent="NotificationModeChipBase">
        <item name="android:background">@drawable/notification_mode_chip</item>
        <item name="android:textColor">@color/notification_mode_chip_text</item>
        <item name="android:button">@null</item>
    </style>
</resources>
