<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        앱 화면 배경. 창·스플래시 배경(themes.xml)으로 써서 Compose 가 그리기 전에도 같은 색이 보이게 한다.
        Compose 의 BgColor(MainActivity.kt)와 같은 값이어야 한다. 어긋나면 AppWindowThemeTest 가 실패한다.
    -->
    <color name="app_background">#2A2C31</color>

    <!--
        Android 12 이상 스플래시에서 로고 뒤에 까는 원의 색(values-v31/themes.xml).
        런처 아이콘의 배경 레이어(mipmap-*/adaptive_icon_background.png)와 같은 흰색이라, 전경 PNG 의 흰 사각 판이
        이 원에 묻힌다(#275). 배경 레이어 색이 바뀌면 함께 바꾼다. 어긋나면 AppWindowThemeTest 가 실패한다.
    -->
    <color name="splash_icon_background">#FFFFFF</color>

    <!--
        실행 중 알림의 모드 칩. 알림 배경색은 기기·테마마다 달라서 밝을 수도 어두울 수도 있는데,
        RemoteViews 에서는 테마 속성을 믿고 쓰기 어렵다. 그래서 칩을 진한 색으로 채우고 글자를 밝게 둬서
        배경이 어느 쪽이든 읽히게 한다. 고른 칩은 앱의 바탕용 강조색(UiColors.kt 의 AccentFillColor)과 같은 값이라 흰 글자가 5.2:1 로 읽힌다(#312).
    -->
    <color name="notification_chip_on">#2563EB</color>
    <color name="notification_chip_off">#4A4F57</color>
    <color name="notification_chip_text_on">#FFFFFF</color>
    <color name="notification_chip_text_off">#E6E9ED</color>

</resources>
