<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12 이상은 앱을 켤 때 시스템 스플래시가 먼저 뜬다. 배경을 앱 배경색으로 두어 스플래시에서
        앱 화면으로 넘어갈 때 색이 튀지 않게 한다. (이 속성들은 API 31 에서 생겨 이 폴더에만 둔다.)
        아이콘 배경색을 두지 않으면 스플래시는 런처 아이콘의 전경만 꺼내 원으로 자른다. 전경 PNG 에는 로고 뒤에
        흰 사각 판이 있어서, 그 판이 네 모서리가 잘린 채 어두운 배경 위에 보였다(#275).
        아이콘 배경색을 런처 아이콘 배경 레이어와 같은 흰색으로 두면, 스플래시가 흰 원을 깔고 그 위에 아이콘을 그려
        흰 판이 원에 묻힌다.
    -->
    <style name="Theme.SoundVisualizer" parent="Base.Theme.SoundVisualizer">
        <item name="android:windowSplashScreenBackground">@color/app_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_icon_background</item>
    </style>
</resources>
