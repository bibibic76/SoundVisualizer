<?xml version="1.0" encoding="utf-8"?>
<!--
    실행 중 알림을 펼쳤을 때 나오는 본문. 상태 한 줄과 모드를 고르는 칩 네 개다.
    알림 기본 동작에 다는 버튼은 보통 세 개까지만 보여서, 모드 네 개를 한눈에 고르게 하려면 본문을 직접 그려야 한다.

    [NotificationCompat.DecoratedCustomViewStyle] 과 함께 쓴다. 머리말(앱 이름·모드 이름·시각·펼침 화살표)과
    아래 [중지] 버튼은 시스템이 그대로 그려 주고, 이 파일은 그 사이만 채운다.

    칩 이름과 눌렀을 때 할 일은 AudioCaptureService.buildModeChooser 가 넣는다.
    RemoteViews 가 다룰 수 있는 뷰만 쓸 수 있어서 LinearLayout 과 TextView 로만 짰다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/notification_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notification_mode_0"
            style="@style/NotificationModeChip" />

        <TextView
            android:id="@+id/notification_mode_1"
            style="@style/NotificationModeChip" />

        <TextView
            android:id="@+id/notification_mode_2"
            style="@style/NotificationModeChip" />

        <TextView
            android:id="@+id/notification_mode_3"
            style="@style/NotificationModeChip" />

    </LinearLayout>

</LinearLayout>
