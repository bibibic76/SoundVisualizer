    <!-- Per-mode settings -->
    <string name="setting_size_lock">鎖定大小</string>
    <string name="setting_size_lock_desc">讓圖形維持固定大小，改以不透明度呈現音量大小。</string>
    <string name="setting_fixed_size">固定大小</string>
    <string name="setting_fixed_size_desc">圖形維持的固定大小。</string>
    <string name="setting_max_opacity">最大不透明度</string>
    <string name="setting_max_opacity_desc">聲音最大時圖形達到的不透明度。</string>
    <string name="setting_size">大小</string>
    <string name="setting_size_desc">調整同樣的聲音要把圖形畫多大。這個設定不會讓較小的聲音更容易被擷取。</string>
    <string name="setting_radius">半徑</string>
    <string name="setting_radius_desc">調整圓形模式中央圓環的半徑。</string>
    <string name="setting_opacity">不透明度</string>
    <string name="setting_opacity_desc">數值越高越鮮明；數值越低越淡、越透明。</string>
    <string name="setting_speed">速度</string>
    <string name="setting_speed_desc">聲音方向改變時，圖形移動到新位置的速度。</string>
    <string name="setting_sensitivity">靈敏度</string>
    <string name="setting_sensitivity_desc">調整音量變化時，圖形放大與縮小的快慢。數值高時會隨節奏跳動，數值低時變化較平緩。這個設定不會讓較小的聲音更容易被擷取。</string>
    <string name="setting_glow">光暈</string>
    <string name="setting_glow_desc">在圖形周圍加上柔和的霓虹光暈效果。注意：會使用較多系統資源。</string>
    <string name="setting_glow_intensity">光暈強度</string>
    <string name="setting_glow_intensity_desc">光暈擴散的範圍。</string>
    <string name="setting_ripple">空間漣漪效果</string>
    <string name="setting_ripple_desc">加入些微延遲，讓聲音彷彿從前方往後方擴散。</string>

    <!-- Battery -->
    <string name="setting_pause_screen_off">螢幕關閉時暫停</string>
    <string name="setting_pause_screen_off_desc">螢幕關閉期間會停止擷取聲音、辨識聲音類型和震動以節省電力，並在你開啟螢幕後繼續。如果希望螢幕關閉時仍收到震動提醒，請關閉這個選項。無論這個設定為何，外部聲音模式在螢幕關閉時都會繼續聆聽。</string>
    <string name="setting_reduced_frame_rate">降低圖形繪製頻率</string>
    <string name="setting_reduced_frame_rate_desc">圖形每秒重新繪製 30 次，而不是 60 次。讓應用程式長時間執行時可以節省電力，但圖形的動畫會比較不流暢。聲音擷取的間隔維持不變。</string>

