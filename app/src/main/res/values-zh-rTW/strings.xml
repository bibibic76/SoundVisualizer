    <!-- Home -->
    <string name="home_subtitle">將看不見的聲音直接描繪在螢幕上。\n從遊戲到電影，開啟全新的體驗。</string>
    <string name="home_status_running">狀態：執行中</string>
    <string name="home_status_running_external">狀態：執行中 · 周遭聲音</string>
    <string name="home_mic_silenced">麥克風沒有收到任何聲音。可能你正在通話、其他應用程式正在使用麥克風，或是在快速設定中關閉了麥克風存取權。</string>
    <string name="home_external_mode">外部聲音模式</string>
    <string name="home_external_mode_desc">透過麥克風聆聽你周遭的聲音，而不是手機內播放的聲音。聲音本身不會被儲存，也不會傳送到任何地方。</string>
    <string name="home_external_mode_locked">執行時無法變更。請先停止聲音視覺化再變更，變更會在下次開啟時生效。</string>
    <string name="home_mic_sensitivity">麥克風靈敏度</string>
    <string name="home_mic_sensitivity_value">%1$d/%2$d</string>
    <string name="home_status_idle">狀態：準備就緒</string>
    <string name="home_capture_blocked">目前接收不到聲音，因此無法繪製任何圖形。可能是正在播放的應用程式不允許分享聲音 (受保護的影片就是這樣)，也可能是該應用程式本身的聲音已靜音。</string>
    <string name="home_ai_unavailable_loud">目前無法辨識聲音類型，所有聲音都會以環境音的顏色顯示，而且只有較大的聲音會依危險音的震動設定震動。請試著關閉聲音視覺化後再重新開啟。</string>
    <string name="home_ai_unavailable">目前無法辨識聲音類型，所有聲音都會以環境音的顏色顯示，震動提醒也已關閉。請試著關閉聲音視覺化後再重新開啟。</string>
    <string name="home_stopped_dismiss">關閉提示</string>
    <string name="home_start">開始</string>
    <string name="home_stop">停止</string>
    <string name="tile_add">新增至快速設定</string>
    <string name="tile_add_desc">下拉通知欄，就能在遊戲或影片畫面上直接開啟或關閉。</string>
    <string name="tile_add_manual">下拉通知欄，輕觸「編輯」(鉛筆圖示) 並新增「聲音視覺化」，就能在遊戲或影片畫面上直接開啟或關閉。</string>
    <string name="settings_tile_title">從通知欄開啟或關閉</string>
    <string name="tile_added">通知欄的快速設定中已有「聲音視覺化」按鈕。</string>
    <string name="home_tutorial">查看教學</string>

    <!-- Tutorial -->
    <string name="tutorial_pane_title">教學</string>
    <string name="tutorial_skip">略過</string>
    <string name="tutorial_back">上一頁</string>
    <string name="tutorial_next">下一步</string>
    <string name="tutorial_done">我知道了</string>
    <string name="tutorial_page_status">第 %1$d 頁，共 %2$d 頁</string>
    <string name="tutorial_pause">暫停動畫</string>
    <string name="tutorial_play">播放動畫</string>
    <string name="tutorial_sound_title">在螢幕上看見聲音</string>
    <string name="tutorial_sound_body">遊戲或影片的聲音會沿著螢幕邊緣描繪出來。聲音越大，圖形就越大。只會顯示手機內播放的聲音。這個應用程式不會擷取你周遭的聲音。</string>
    <string name="tutorial_sound_body_external">外部聲音模式已開啟，因此麥克風聽到的周遭聲音會沿著螢幕邊緣描繪出來。聲音越大，圖形就越大。在這個模式下，不會顯示手機內播放的聲音。</string>
    <string name="tutorial_direction_title">可以分辨左右</string>
    <string name="tutorial_direction_title_external">方向目前只顯示在中間</string>
    <string name="tutorial_direction_body">來自左邊的聲音會在左側顯示得更大，來自右邊的聲音會在右側顯示得更大。無法分辨前後。</string>
    <string name="tutorial_direction_body_external">在外部聲音模式下，應用程式暫時不會顯示聲音來自哪一側，所有聲音都會顯示在中間。手機內播放的聲音，來自左邊的聲音會在左側顯示得更大。</string>
    <string name="tutorial_types_title">用顏色區分聲音類型</string>
    <string name="tutorial_types_body">AI 會將聲音分為三種類型，並以不同顏色顯示。你可以在「設定」分頁中變更顏色。</string>
    <string name="tutorial_type_ambient">環境音</string>
    <string name="tutorial_type_ambient_examples">音樂、雨聲等其他聲音</string>
    <string name="tutorial_type_speech">人聲</string>
    <string name="tutorial_type_speech_examples">說話聲</string>
    <string name="tutorial_type_danger">危險音</string>
    <string name="tutorial_type_danger_examples">槍聲、爆炸聲、警報聲</string>
    <string name="tutorial_vibration_title">危險音還會以震動提醒</string>
    <string name="tutorial_vibration_body">遊戲或影片中出現危險音時，手機會震動。即使沒有看著螢幕，也能察覺到。預設只有危險音會震動。你可以在「設定」分頁中為每種類型開啟或關閉震動。</string>
    <string name="tutorial_start_title">如何開啟和關閉</string>
    <string name="tutorial_privacy_note">麥克風和螢幕錄影權限只會用來擷取手機內播放的聲音。你周遭的聲音和螢幕畫面都不會被錄下。</string>
    <string name="tutorial_privacy_note_external">外部聲音模式會透過麥克風聆聽你周遭的聲音。聲音本身不會存成檔案，也不會傳送到任何地方，螢幕畫面也不會被錄下。</string>

    <!-- Permissions -->
    <string name="permission_overlay_title">請允許「在其他應用程式上層顯示」</string>
    <string name="permission_overlay_message">聲音會繪製在遊戲或影片的上層，因此 Android 需要這項權限。如果設定畫面顯示應用程式清單，請找到 SoundVisualizer 並開啟它的開關，然後返回。回來後會自動接著繼續。</string>
    <string name="permission_record_audio_required">需要麥克風 (錄音) 權限才能擷取音訊。</string>
    <string name="permission_mic_rationale_title">為什麼需要麥克風權限？</string>
    <string name="permission_mic_rationale_message">Android 規定必須取得麥克風權限，才能擷取手機內正在播放的聲音。這個應用程式不會錄下你周遭的聲音。</string>
    <string name="permission_mic_rationale_message_external">外部聲音模式會透過麥克風聆聽你周遭的聲音，並用螢幕和震動告訴你。在 Android 12 以上版本中，聆聽期間狀態列會顯示麥克風圖示。聲音本身不會存成檔案，也不會傳送到任何地方。外部聲音模式在螢幕關閉時也會繼續聆聽。</string>
    <string name="permission_mic_settings_title">請在設定中允許使用麥克風</string>
    <string name="permission_mic_settings_message">尚未取得麥克風權限。如果權限要求視窗沒有再次出現，請輕觸「開啟設定」，然後在「權限」中允許「麥克風」。這項權限只會用來擷取手機內播放的聲音，不會錄下你周遭的聲音。</string>
    <string name="permission_mic_settings_message_external">尚未取得麥克風權限。如果權限要求視窗沒有再次出現，請輕觸「開啟設定」，然後在「權限」中允許「麥克風」。外部聲音模式會透過麥克風聆聽你周遭的聲音。聲音本身不會存成檔案，也不會傳送到任何地方。外部聲音模式在螢幕關閉時也會繼續聆聽。</string>
    <string name="permission_continue">繼續</string>
    <string name="permission_cancel">取消</string>
    <string name="permission_open_settings">開啟設定</string>
    <string name="permission_close">關閉</string>

