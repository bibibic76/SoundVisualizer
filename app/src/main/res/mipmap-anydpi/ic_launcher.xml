<?xml version="1.0" encoding="utf-8"?>
<!--
    런처 아이콘. 배경·전경은 밀도별 PNG 로 받은 디자인 파일이다.
    파일 이름을 ic_launcher_* 로 두면 Lint 가 이 둘을 런처 아이콘 자체로 보고 "정사각을 가득 채우지 말라"고 경고한다.
    배경 레이어는 가득 채우는 게 규격이므로, 레이어임이 드러나는 이름을 쓴다.
    단색(monochrome)은 Android 13 이상의 테마 아이콘에서 쓰는데, 시스템이 알파만 보고 한 색으로 칠한다.
    전경 PNG 는 안쪽이 흰색으로 차 있어 동그라미 하나로 뭉개지므로, 선만 남은 벡터를 따로 쓴다.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/adaptive_icon_background" />
    <foreground android:drawable="@mipmap/adaptive_icon_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
